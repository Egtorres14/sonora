{
  "name": "audio-project-evaluator-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "corpus:fetch": "tsx scripts/corpus/fetch-sources.ts",
    "corpus:build": "tsx scripts/corpus/build-corpus.ts --sources corpus/sources --out corpus",
    "corpus:synthetic": "tsx scripts/corpus/build-corpus.ts --synthetic --out corpus-sintetico --wav none"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google/genai": "^1.20.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.42.0",
    "ml-random-forest": "^2.1.0",
    "openai": "^7.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "wavesurfer.js": "^7.11.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "audio-decode": "^3.12.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
